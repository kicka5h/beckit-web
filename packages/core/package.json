    "api:update": "tsc -p tsconfig.api.json && api-extractor run --local"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
